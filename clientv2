</head>
<body class="bg-brand-dark text-slate-100 antialiased font-sans selection:bg-brand-red selection:text-white bg-pro-cinematic min-h-screen flex flex-col justify-between overflow-x-hidden">

    <!-- NAVBAR HEADER -->
    <header class="fixed top-0 w-full bg-brand-dark/80 backdrop-blur-xl z-40 border-b border-brand-border/60">
        <div class="max-w-7xl mx-auto px-6 sm:px-10 h-20 flex justify-between items-center">
            <a href="index.html" class="text-xl font-extrabold tracking-wider">
                BAGUS<span class="text-brand-red">INVISUAL</span>
            </a>

            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-300">
                <a href="index.html" class="hover:text-brand-red transition">Beranda</a>
                <a href="galeri.html" class="text-brand-red transition">Galeri</a>
                <a href="https://wa.me/6289531796291" target="_blank" class="bg-brand-red hover:bg-red-600 text-white px-5 py-2.5 rounded-full transition shadow-lg shadow-brand-red/20 flex items-center gap-2">
                    <i class="fa-brands fa-whatsapp"></i> Kontak Kami
                </a>
            </nav>
        </div>
    </header>

    <!-- MAIN CONTENT GALERI -->
    <main class="pt-28 pb-16 px-6 sm:px-10 max-w-7xl mx-auto w-full flex-grow animate-fade">
        
        <!-- SECTION TITLE -->
        <div class="mb-10 text-center sm:text-left border-b border-brand-border/80 pb-6">
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">GALERI PORTOFOLIO</h1>
            <p class="text-slate-400 text-sm mt-2">Kumpulan karya videografi, video editing, dan dokumentasi visual.</p>
        </div>

        <!-- GRID GALERI PORTOFOLIO -->
        <div id="galeriGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Loading Indicator -->
            <div class="col-span-full text-center py-16 text-slate-400">
                <i class="fa-solid fa-spinner fa-spin text-brand-red text-2xl mb-2"></i>
                <p class="text-sm">Memuat karya portofolio...</p>
            </div>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="w-full bg-brand-card border-t border-brand-border py-8 px-6 sm:px-10 mt-auto">
        <div class="w-full max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
            <p>&copy; 2026 Bagus Wahyu Widodo (Bagusinvisual). All rights reserved.</p>
        </div>
    </footer>

    <!-- JAVASCRIPT INTEGRASI GOOGLE DRIVE & YOUTUBE -->
    <script>
        // Transformasi link Google Drive biasa menjadi Embed Preview URL
        function getDriveEmbedUrl(url) {
            if (!url) return null;
            if (url.includes('drive.google.com')) {
                const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
                if (match && match[1]) {
                    return `https://drive.google.com/file/d/${match[1]}/preview`;
                }
            }
            return url;
        }

        // Helper Ekstraksi YouTube ID
        function getYouTubeId(url) {
            if (!url) return null;
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        // Parsing porto.txt & Render HTML
        async function loadGaleriPorto() {
            const container = document.getElementById('galeriGrid');
            try {
                const response = await fetch('porto.txt');
                if (!response.ok) throw new Error('File porto.txt tidak ditemukan');
                
                const text = await response.text();
                const blocks = text.split('---').map(b => b.trim()).filter(b => b.length > 0);
                const items = [];

                blocks.forEach(block => {
                    const lines = block.split('\n');
                    const item = {};
                    lines.forEach(line => {
                        const colonIndex = line.indexOf(':');
                        if (colonIndex !== -1) {
                            const key = line.substring(0, colonIndex).trim().toLowerCase();
                            const value = line.substring(colonIndex + 1).trim();
                            item[key] = value;
                        }
                    });
                    if (Object.keys(item).length > 0) {
                        items.push(item);
                    }
                });

                if (items.length === 0) {
                    container.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400">Belum ada data portofolio di porto.txt</div>`;
                    return;
                }

                container.innerHTML = items.map(item => {
                    const title = item.title || item.judul || 'Portofolio Visual';
                    const category = item.category || item.kategori || 'Video';
                    const rawUrl = item.url || item.link || '#';
                    
                    const isDrive = rawUrl.includes('drive.google.com');

                    // 1. TAMPILAN JIKA SUMBER ADALAH GOOGLE DRIVE (EMBED PLAYER)
                    if (isDrive) {
                        const embedUrl = getDriveEmbedUrl(rawUrl);
                        return `
                            <div class="bg-brand-card border border-brand-border rounded-2xl overflow-hidden shadow-lg flex flex-col justify-between hover:border-brand-red/50 transition duration-300">
                                <div class="relative w-full h-56 bg-black">
                                    <iframe 
                                        src="${embedUrl}" 
                                        class="w-full h-full border-0" 
                                        allow="autoplay" 
                                        loading="lazy"
                                        allowfullscreen>
                                    </iframe>
                                </div>
                                <div class="p-4 flex items-center justify-between border-t border-brand-border/60">
                                    <div>
                                        <span class="bg-brand-red/90 text-white text-[10px] font-bold uppercase px-2.5 py-0.5 rounded">
                                            ${category}
                                        </span>
                                        <h3 class="text-sm font-bold text-white mt-1.5 truncate max-w-[200px]">${title}</h3>
                                    </div>
                                    <a href="${rawUrl}" target="_blank" title="Buka di Drive" class="text-slate-400 hover:text-brand-red transition">
                                        <i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
                                    </a>
                                </div>
                            </div>
                        `;
                    }

                    // 2. TAMPILAN JIKA SUMBER ADALAH YOUTUBE / WEBLINK BIASA
                    const ytId = getYouTubeId(rawUrl);
                    const thumbUrl = ytId 
                        ? `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`
                        : (item.image || item.thumbnail || 'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=600&q=80');

                    return `
                        <a href="${rawUrl}" target="_blank" class="group bg-brand-card border border-brand-border hover:border-brand-red/60 rounded-2xl overflow-hidden transition duration-300 shadow-lg flex flex-col justify-between">
                            <div class="relative h-56 overflow-hidden bg-brand-dark">
                                <img src="${thumbUrl}" alt="${title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                                <span class="absolute top-3 left-3 bg-brand-red/90 text-white text-[10px] font-bold uppercase px-2.5 py-0.5 rounded shadow">
                                    ${category}
                                </span>
                            </div>
                            <div class="p-4 flex items-center justify-between border-t border-brand-border/60">
                                <h3 class="text-sm font-bold text-white truncate pr-2">${title}</h3>
                                <i class="fa-solid fa-arrow-up-right-from-square text-sm text-brand-red"></i>
                            </div>
                        </a>
                    `;
                }).join('');

            } catch (err) {
                console.error(err);
                container.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400">Gagal memuat file porto.txt</div>`;
            }
        }

        document.addEventListener('DOMContentLoaded', loadGaleriPorto);
    </script>
</body>
</html>
