    <style>
        .bg-pro-cinematic {
            background-color: #0A0A0C;
            background-image: 
                radial-gradient(circle at 10% 10%, rgba(255, 46, 76, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 46, 76, 0.05) 0%, transparent 45%),
